{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "discard",
  "version": "0.1.1",
  "identifier": "com.eclecticstack.discard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "discard",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwOTIzN0YxNDY5RTRCMTcKUldRWFM1NUc4VGVTRUozRGpLSmo2ZHNBU01xZmZYcXNxQys3WmlUYVRudWRXK3dOMHVJMWhneEgK",
      "endpoints": [
        "https://github.com/bretamerman/discard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
